# Ghostty Configuration
# Docs:   https://ghostty.org/docs/config
# Themes: ghostty +list-themes
# All options: ghostty +show-config --default --docs

# ─── Appearance ──────────────────────────────────────────────────────────────

theme                    = Everforest Dark Hard
font-family              = JetBrainsMono Nerd Font
font-size                = 18
cursor-style             = block
cursor-style-blink       = false
window-padding-x         = 6
window-padding-y         = 6
maximize = true

# ─── Splits (all alt = left-ring LALT + right-hand tap; one mod throughout) ────
# Daily loop: alt+m/n/e/i create <-/down/up/right · alt+o next · alt+y prev · alt+u close
# alt+shift+m/n/e/i goto dir (rare) · ctrl+alt+m/n/e/i resize · ctrl+shift+w kill whole tab

keybind = alt+m=new_split:left
keybind = alt+n=new_split:down
keybind = alt+e=new_split:up
keybind = alt+i=new_split:right
keybind = alt+shift+m=goto_split:left
keybind = alt+shift+n=goto_split:bottom
keybind = alt+shift+e=goto_split:top
keybind = alt+shift+i=goto_split:right
keybind = alt+o=goto_split:next
keybind = alt+y=goto_split:previous
keybind = alt+u=close_surface
keybind = ctrl+shift+e=unbind
keybind = ctrl+shift+o=unbind

# ─── Resize Splits (ctrl+alt+m/n/e/i) ────────────────────────────────────────

keybind = ctrl+alt+m=resize_split:left,50
keybind = ctrl+alt+n=resize_split:down,50
keybind = ctrl+alt+e=resize_split:up,50
keybind = ctrl+alt+i=resize_split:right,50

# ─── Tabs (ctrl+shift+h/l — mirrors <S-h>/<S-l> buffer cycling in nvim) ──────

keybind = ctrl+t=new_tab
keybind = ctrl+shift+l=next_tab
keybind = ctrl+shift+h=previous_tab
keybind = ctrl+shift+t=prompt_tab_title

# ─── Miscellaneous ───────────────────────────────────────────────────────────

keybind = ctrl+shift+period=open_config
keybind = ctrl+shift+slash=toggle_window_decorations
